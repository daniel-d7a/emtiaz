{
  "name": "emtiaz",
  "main": "./frontend/worker.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/sitemap.xml",
      "/robots.txt"
    ]
  }
}
