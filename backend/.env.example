DATABASE_URL="postgresql://postgres:password@localhost:5433/oman_lms"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5434/oman_lms_test"
BETTER_AUTH_SECRET="super-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Optional: endpoint embedded in presigned URLs when the API runs behind Docker
R2_PRESIGN_ENDPOINT=""
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_REGION="auto"
R2_BUCKET_NAME="lms-attachments"
FRONTEND_URL="http://localhost:5173"
BETTER_AUTH_URL=http://localhost:3000/api/auth

# pino log level: trace|debug|info|warn|error|silent
LOG_LEVEL="info"

# Per-account sign-in lockout (in-memory; use Redis for multiple API replicas)
LOGIN_LOCKOUT_MAX="5"
LOGIN_LOCKOUT_WINDOW_MS="900000"
LOGIN_LOCKOUT_MS="900000"

# Optional email delivery webhook (receives {to, subject, body}); mock sender when unset
EMAIL_WEBHOOK_URL=""

# Serve /api/docs in production (enabled by default outside production)
ENABLE_API_DOCS=0
